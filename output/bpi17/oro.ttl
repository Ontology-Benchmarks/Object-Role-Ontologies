<http://www.example.com/oro/R/application/Accepted_complete> a owl:Class ;
    rdfs:label "R_{Accepted_complete}(application)" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onClass <http://www.example.com/oro/Ev/Accepted_complete> ;
                        owl:onProperty [ owl:inverseOf oro:frames ] ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass ex:otype_application ;
                        owl:onProperty [ owl:inverseOf oro:playsRole ] ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

