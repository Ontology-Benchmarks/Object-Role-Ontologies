oro:dl a owl:AnnotationProperty .

<http://www.example.com/oro/log/bpi17_ocel> a owl:Ontology ;
    rdfs:label "Object Role Ontology of bpi17_ocel" ;
    rdfs:comment "T-box of the ORO: core axioms (Section 4) and the behavioural axioms inferred bottom-up on the log. The A-box is virtual (Ontop VKG over DuckDB) and uses the same IRIs." .

oro:nonEmpty a owl:AnnotationProperty .

oro:schema a owl:AnnotationProperty .

oro:Event a owl:Class ;
    rdfs:label "Event" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://www.example.com/oro/Ev/Accepted_complete> <http://www.example.com/oro/Ev/Assess%20potential%20fraud_complete> <http://www.example.com/oro/Ev/Call%20after%20offers_complete> <http://www.example.com/oro/Ev/Call%20incomplete%20files_complete> <http://www.example.com/oro/Ev/Cancelled_complete> <http://www.example.com/oro/Ev/Complete%20application_complete> <http://www.example.com/oro/Ev/Complete_complete> <http://www.example.com/oro/Ev/Concept_complete> <http://www.example.com/oro/Ev/Create%20Application_complete> <http://www.example.com/oro/Ev/Create%20Offer_complete> <http://www.example.com/oro/Ev/Created_complete> <http://www.example.com/oro/Ev/Denied_complete> <http://www.example.com/oro/Ev/Handle%20leads_complete> <http://www.example.com/oro/Ev/Incomplete_complete> <http://www.example.com/oro/Ev/Pending_complete> <http://www.example.com/oro/Ev/Refused_complete> <http://www.example.com/oro/Ev/Returned_complete> <http://www.example.com/oro/Ev/Sent%20%28mail%20and%20online%29_complete> <http://www.example.com/oro/Ev/Sent%20%28online%20only%29_complete> <http://www.example.com/oro/Ev/Submitted_complete> <http://www.example.com/oro/Ev/Validate%20application_complete> <http://www.example.com/oro/Ev/Validating_complete> ) ] .

oro:Object a owl:Class ;
    rdfs:label "O" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ex:otype_application ex:otype_offer ex:otype_resource ex:otype_workflow ) ] .

