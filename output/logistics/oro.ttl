            owl:allValuesFrom <http://www.example.com/oro/Role/container> ;
            owl:onProperty oro:nextRole ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://www.example.com/oro/R/container/Bring%20to%20Loading%20Bay> <http://www.example.com/oro/R/container/Depart> <http://www.example.com/oro/R/container/Drive%20to%20Terminal> <http://www.example.com/oro/R/container/Load%20Truck> <http://www.example.com/oro/R/container/Load%20to%20Vehicle> <http://www.example.com/oro/R/container/Order%20Empty%20Containers> <http://www.example.com/oro/R/container/Pick%20Up%20Empty%20Container> <http://www.example.com/oro/R/container/Place%20in%20Stock> <http://www.example.com/oro/R/container/Reschedule%20Container> <http://www.example.com/oro/R/container/Weigh> ) ] .

