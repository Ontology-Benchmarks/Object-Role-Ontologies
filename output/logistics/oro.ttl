ex:otype_truck a owl:Class ;
    rdfs:label "O_truck" ;
    oro:dl "O_truck ⊑ ∀playsRole.¬(R_init(truck) ⊔ R_close(truck))" ;
    oro:schema "ext" .

oro:REnd a owl:Class ;
    rdfs:label "R_end" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oro:Role [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty oro:nextRole ;
                                owl:someValuesFrom oro:Role ] ] ) ] .

oro:RStart a owl:Class ;
    rdfs:label "R_start" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oro:Role [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty [ owl:inverseOf oro:nextRole ] ;
                                owl:someValuesFrom oro:Role ] ] ) ] .

