@prefix ex: <http://www.example.com/> .
@prefix oro: <http://www.example.com/oro/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oro:dl a owl:AnnotationProperty .

<http://www.example.com/oro/log/ContainerLogistics> a owl:Ontology ;
    rdfs:label "Object Role Ontology of ContainerLogistics" ;
    rdfs:comment "T-box of the ORO: core axioms (Section 4) and the behavioural axioms inferred bottom-up on the log. The A-box is virtual (Ontop VKG over DuckDB) and uses the same IRIs." .

oro:nonEmpty a owl:AnnotationProperty .

oro:schema a owl:AnnotationProperty .

oro:Event a owl:Class ;
    rdfs:label "Event" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://www.example.com/oro/Ev/Book%20Vehicles> <http://www.example.com/oro/Ev/Bring%20to%20Loading%20Bay> <http://www.example.com/oro/Ev/Collect%20Goods> <http://www.example.com/oro/Ev/Create%20Transport%20Document> <http://www.example.com/oro/Ev/Depart> <http://www.example.com/oro/Ev/Drive%20to%20Terminal> <http://www.example.com/oro/Ev/Load%20Truck> <http://www.example.com/oro/Ev/Load%20to%20Vehicle> <http://www.example.com/oro/Ev/Order%20Empty%20Containers> <http://www.example.com/oro/Ev/Pick%20Up%20Empty%20Container> <http://www.example.com/oro/Ev/Place%20in%20Stock> <http://www.example.com/oro/Ev/Register%20Customer%20Order> <http://www.example.com/oro/Ev/Reschedule%20Container> <http://www.example.com/oro/Ev/Weigh> ) ] .

oro:Object a owl:Class ;
    rdfs:label "O" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ex:otype_container ex:otype_customer_order ex:otype_forklift ex:otype_handling_unit ex:otype_transport_document ex:otype_truck ex:otype_vehicle ) ] .

