@prefix ex: <http://www.example.com/> .
@prefix oro: <http://www.example.com/oro/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oro:dl a owl:AnnotationProperty .

<http://www.example.com/oro/log/ocel2-p2p> a owl:Ontology ;
    rdfs:label "Object Role Ontology of ocel2-p2p" ;
    rdfs:comment "T-box of the ORO: core axioms (Section 4) and the behavioural axioms inferred bottom-up on the log. The A-box is virtual (Ontop VKG over DuckDB) and uses the same IRIs." .

oro:nonEmpty a owl:AnnotationProperty .

oro:schema a owl:AnnotationProperty .

oro:Event a owl:Class ;
    rdfs:label "Event" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://www.example.com/oro/Ev/Approve%20Purchase%20Order> <http://www.example.com/oro/Ev/Approve%20Purchase%20Requisition> <http://www.example.com/oro/Ev/Create%20Goods%20Receipt> <http://www.example.com/oro/Ev/Create%20Invoice%20Receipt> <http://www.example.com/oro/Ev/Create%20Purchase%20Order> <http://www.example.com/oro/Ev/Create%20Purchase%20Requisition> <http://www.example.com/oro/Ev/Create%20Request%20for%20Quotation> <http://www.example.com/oro/Ev/Delegate%20Purchase%20Requisition%20Approval> <http://www.example.com/oro/Ev/Execute%20Payment> <http://www.example.com/oro/Ev/Perform%20Two-Way%20Match> ) ] .

oro:Object a owl:Class ;
    rdfs:label "O" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ex:otype_goods_receipt ex:otype_invoice_receipt ex:otype_material ex:otype_payment ex:otype_purchase_order ex:otype_purchase_requisition ex:otype_quotation ex:otype_resource ) ] .

