@prefix ex: <http://www.example.com/> .
@prefix oro: <http://www.example.com/oro/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oro:dl a owl:AnnotationProperty .

<http://www.example.com/oro/log/order-management> a owl:Ontology ;
    rdfs:label "Object Role Ontology of order-management" ;
    rdfs:comment "T-box of the ORO: core axioms (Section 4) and the behavioural axioms inferred bottom-up on the log. The A-box is virtual (Ontop VKG over DuckDB) and uses the same IRIs." .

oro:nonEmpty a owl:AnnotationProperty .

oro:schema a owl:AnnotationProperty .

oro:Event a owl:Class ;
    rdfs:label "Event" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( <http://www.example.com/oro/Ev/confirm%20order> <http://www.example.com/oro/Ev/create%20package> <http://www.example.com/oro/Ev/failed%20delivery> <http://www.example.com/oro/Ev/item%20out%20of%20stock> <http://www.example.com/oro/Ev/package%20delivered> <http://www.example.com/oro/Ev/pay%20order> <http://www.example.com/oro/Ev/payment%20reminder> <http://www.example.com/oro/Ev/pick%20item> <http://www.example.com/oro/Ev/place%20order> <http://www.example.com/oro/Ev/reorder%20item> <http://www.example.com/oro/Ev/send%20package> ) ] .

oro:Object a owl:Class ;
    rdfs:label "O" ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ex:otype_customers ex:otype_employees ex:otype_items ex:otype_orders ex:otype_packages ex:otype_products ) ] .

