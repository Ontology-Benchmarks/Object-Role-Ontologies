PREFIX ex: <http://www.example.com/>
PREFIX ocel: <https://stl.mie.utoronto.ca/ontologies/ocel/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?obj ?event ?eventTimestamp ?eventActivity ?closingEvent ?closingTimestamp ?closingActivity
WHERE {
    VALUES ?eventActivity { <https://stl.mie.utoronto.ca/ontologies/ocel/Sent%20%28mail%20and%20online%29_complete> <https://stl.mie.utoronto.ca/ontologies/ocel/Sent%20%28online%20only%29_complete> }
    ?obj rdf:type <http://www.example.com/otype_offer> ;
         ocel:latestEvent ?closingEvent .
    ?event ocel:involves ?obj ;
           ocel:hasActivity ?eventActivity ;
           ocel:timestamp ?eventTimestamp .
    ?closingEvent ocel:hasActivity ?closingActivity ;
                  ocel:timestamp ?closingTimestamp .
    OPTIONAL {
        {
            SELECT ?obj (MAX(?targetTimestamp) AS ?lastTargetTimestamp)
            WHERE {
                VALUES ?targetActivity { <https://stl.mie.utoronto.ca/ontologies/ocel/Returned_complete> }
                ?obj rdf:type <http://www.example.com/otype_offer> .
                ?targetEvent ocel:involves ?obj ;
                             ocel:hasActivity ?targetActivity ;
                             ocel:timestamp ?targetTimestamp .
            }
            GROUP BY ?obj
        }
    }
    FILTER(!BOUND(?lastTargetTimestamp) || ?lastTargetTimestamp <= ?eventTimestamp)
}
ORDER BY ?obj ?eventTimestamp ?event
