PREFIX ocel: <https://stl.mie.utoronto.ca/ontologies/ocel/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?obj (COUNT(DISTINCT ?a) AS ?n)
WHERE {
    ?obj rdf:type <http://www.example.com/otype_offer> .
    OPTIONAL {
        ?ev ocel:involves ?obj ; ocel:hasActivity ?a .
        VALUES ?a { <https://stl.mie.utoronto.ca/ontologies/ocel/Accepted_complete> <https://stl.mie.utoronto.ca/ontologies/ocel/Cancelled_complete> <https://stl.mie.utoronto.ca/ontologies/ocel/Refused_complete> }
    }
}
GROUP BY ?obj
HAVING (COUNT(DISTINCT ?a) != 1)
