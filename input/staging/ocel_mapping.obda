[PrefixDeclaration]
ex:		http://www.example.com/
ocel:		https://stl.mie.utoronto.ca/ontologies/ocel/
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:		http://www.w3.org/2000/01/rdf-schema#
xsd:		http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[

mappingId	events
target		ex:{eid} a ocel:Event ; ocel:hasActivity ocel:{activity} ; ocel:timestamp {timestamp}^^xsd:dateTime .
source		SELECT * FROM log_events

mappingId	e2o
target		ex:{eid} ocel:involves ex:{object_id} .
source		SELECT eid, object_id FROM log_e2o

mappingId	objects
target		ex:{object_id} a ocel:Object ; ocel:earliestEvent ex:{earliest_event_id} ; ocel:latestEvent ex:{latest_event_id} .
source		SELECT object_id, earliest_event_id, latest_event_id FROM objects

mappingId	object_interaction_graph
target		ex:o2o_{oid1}_{oid2}_{event_id} a ocel:ObjectRelationship ; ocel:relatesA ex:{oid1} ; ocel:relatesB ex:{oid2} ; ocel:viaEvent ex:{event_id} .
source		SELECT oid1, oid2, event_id FROM o2o

mappingId	aggregated_object_interaction_graph
target		ex:eventRole_{activity}_{otype} a ex:EventObjectRole ; ex:playsRoleIn ocel:{activity} ; ex:isRoleOf ex:otype_{otype} ; ex:participationPopulation {part_pop}^^xsd:integer ; ex:totalPopulation {total_pop}^^xsd:integer ; ex:objectRoleMinCardinality {object_role_min_card}^^xsd:integer ; ex:objectRoleMaxCardinality {object_role_max_card}^^xsd:integer ; ex:eventRoleMinCardinality {event_role_min_card}^^xsd:integer ; ex:eventRoleMaxCardinality {event_role_max_card}^^xsd:integer ; ex:minCardinality {min_card}^^xsd:integer ; ex:maxCardinality {max_card}^^xsd:integer .
source		SELECT activity, otype, part_pop, total_pop, object_role_min_card, object_role_max_card, event_role_min_card, event_role_max_card, min_card, max_card FROM o2o_event_object_roles

mappingId	objects_type_resource
target		ex:{object_id} a ex:otype_resource .
source		SELECT object_id FROM obj_resource

mappingId	objects_type_application
target		ex:{object_id} a ex:otype_application .
source		SELECT object_id FROM obj_application

mappingId	objects_type_offer
target		ex:{object_id} a ex:otype_offer .
source		SELECT object_id FROM obj_offer

mappingId	objects_type_workflow
target		ex:{object_id} a ex:otype_workflow .
source		SELECT object_id FROM obj_workflow

mappingId	oro_roles
target		<http://www.example.com/oro/role/{object_id}/{eid}> a <http://www.example.com/oro/Role> ; <http://www.example.com/oro/memberOf> ex:eventRole_{activity}_{otype} . ex:{object_id} <http://www.example.com/oro/playsRole> <http://www.example.com/oro/role/{object_id}/{eid}> . ex:{eid} <http://www.example.com/oro/frames> <http://www.example.com/oro/role/{object_id}/{eid}> .
source		SELECT object_id, eid, otype, activity FROM oro_roles

mappingId	oro_objects
target		ex:{object_id} a <http://www.example.com/oro/Object> .
source		SELECT object_id FROM objects

mappingId	oro_events
target		ex:{eid} a <http://www.example.com/oro/Event> .
source		SELECT eid FROM log_events

mappingId	oro_next_role
target		<http://www.example.com/oro/role/{object_id}/{eid1}> <http://www.example.com/oro/nextRole> <http://www.example.com/oro/role/{object_id}/{eid2}> .
source		SELECT object_id, eid1, eid2 FROM oro_next_role

mappingId	oro_later_role
target		<http://www.example.com/oro/role/{object_id}/{eid1}> <http://www.example.com/oro/laterRole> <http://www.example.com/oro/role/{object_id}/{eid2}> .
source		SELECT a.object_id, a.eid AS eid1, b.eid AS eid2 FROM oro_roles a JOIN oro_roles b ON a.object_id = b.object_id AND a.pos < b.pos

mappingId	oro_role_class_0
target		<http://www.example.com/oro/role/{object_id}/{eid}> a <http://www.example.com/oro/R/application/Accepted_complete> .
source		SELECT object_id, eid FROM oro_roles WHERE otype = 'application' AND activity = 'Accepted_complete'

mappingId	oro_role_class_1
target		<http://www.example.com/oro/role/{object_id}/{eid}> a <http://www.example.com/oro/R/application/Assess%20potential%20fraud_complete> .
source		SELECT object_id, eid FROM oro_roles WHERE otype = 'application' AND activity = 'Assess potential fraud_complete'

